<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MyVpn.Service — the privileged VPN helper.

    Runs as a system service (Windows LocalSystem / Linux root systemd unit /
    macOS privileged launchd daemon). It owns everything that needs elevation:
    TUN device, routes, firewall/Kill Switch, DNS, process routing and — where a
    platform requires it — the Xray process itself.

    It exposes a narrow, authenticated IPC surface and never exposes a generic
    "run this command" or "apply this raw config" operation.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MyVpn.Service</RootNamespace>
    <AssemblyName>myvpn-service</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MyVpn.Core/MyVpn.Core.csproj" />
    <ProjectReference Include="../MyVpn.Application/MyVpn.Application.csproj" />
    <ProjectReference Include="../MyVpn.Infrastructure/MyVpn.Infrastructure.csproj" />
    <ProjectReference Include="../MyVpn.Platform.Abstractions/MyVpn.Platform.Abstractions.csproj" />
    <ProjectReference Include="../MyVpn.Platform.Linux/MyVpn.Platform.Linux.csproj" />
    <ProjectReference Include="../MyVpn.Platform.Windows/MyVpn.Platform.Windows.csproj" />
    <ProjectReference Include="../MyVpn.Platform.MacOS/MyVpn.Platform.MacOS.csproj" />
    <ProjectReference Include="../MyVpn.Ipc/MyVpn.Ipc.csproj" />
  </ItemGroup>

</Project>
