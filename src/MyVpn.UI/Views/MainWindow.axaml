<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyVpn.UI.ViewModels"
        xmlns:views="using:MyVpn.UI.Views"
        x:Class="MyVpn.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding AppTitle}"
        Icon="avares://myvpn-ui/Assets/myvpn.png"
        Width="560" Height="720"
        MinWidth="460" MinHeight="600">

  <!--
    The main screen carries the actions that matter and nothing else. Technical parameters
    live behind Advanced Mode; a first-time user should be able to connect without knowing
    what an outbound or a geosite is.

    Every tab is a UserControl over a view model that the composition root built. The window
    itself does nothing but host them: it never reaches for a port, a platform service or the
    Xray process, and the connect action is a command on the main view model, which reaches
    the machine only through IVpnSession.
  -->
  <DockPanel Margin="18">

    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,12">
      <TextBlock Text="{Binding AppTitle}" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="{Binding AppSubtitle}" Opacity="0.6" FontSize="13" />
    </StackPanel>

    <!-- Status card. Always visible, on every tab: the connection state is the one thing a
         user must never have to go looking for. -->
    <Border DockPanel.Dock="Top"
            CornerRadius="10"
            Padding="14"
            Margin="0,0,0,12"
            Background="{DynamicResource SystemControlBackgroundListLowBrush}">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding StatusText}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{Binding ServerName}"
                   Opacity="0.75"
                   FontSize="13"
                   TextTrimming="CharacterEllipsis" />

        <!-- The truth about verification, next to the state rather than buried in a table. -->
        <TextBlock Text="{Binding TrafficMoved}" FontSize="13" />
      </StackPanel>
    </Border>

    <!-- Language switching stays outside the tabs: it is chrome, not a screen. -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,12,0,0">
      <TextBlock Text="{Binding LabelLanguage}" VerticalAlignment="Center" Opacity="0.6" FontSize="12" />
      <Button Content="EN" Command="{Binding SetLanguageCommand}" CommandParameter="en" />
      <Button Content="RU" Command="{Binding SetLanguageCommand}" CommandParameter="ru" />
      <Button Content="中文" Command="{Binding SetLanguageCommand}" CommandParameter="zh-Hans" />
    </StackPanel>

    <TabControl>
      <TabItem Header="{Binding ConnectTabLabel}">
        <views:ConnectionView DataContext="{Binding}" />
      </TabItem>

      <TabItem Header="{Binding ServersTabLabel}">
        <views:ServerListView DataContext="{Binding Servers}" />
      </TabItem>

      <TabItem Header="{Binding SubscriptionTabLabel}">
        <views:SubscriptionImportView DataContext="{Binding Subscription}" />
      </TabItem>

      <TabItem Header="{Binding DiagnosticsTabLabel}">
        <views:DiagnosticsView DataContext="{Binding Diagnostics}" />
      </TabItem>

      <TabItem Header="{Binding SettingsTabLabel}">
        <views:SettingsView DataContext="{Binding Settings}" />
      </TabItem>
    </TabControl>

  </DockPanel>
</Window>
