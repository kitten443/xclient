<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyVpn.UI.ViewModels"
        x:Class="MyVpn.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding AppTitle}"
        Width="520" Height="640"
        MinWidth="440" MinHeight="560">

  <!--
    The main screen carries the actions that matter and nothing else. Technical parameters
    are behind Advanced Mode; a first-time user should be able to connect without knowing
    what an outbound or a geosite is.
  -->
  <DockPanel Margin="22">

    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,18">
      <TextBlock Text="{Binding AppTitle}" FontSize="26" FontWeight="SemiBold" />
      <TextBlock Text="{Binding AppSubtitle}" Opacity="0.6" FontSize="13" />
    </StackPanel>

    <!-- Status card -->
    <Border DockPanel.Dock="Top"
            CornerRadius="10"
            Padding="16"
            Background="{DynamicResource SystemControlBackgroundListLowBrush}">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding StatusText}" FontSize="19" FontWeight="SemiBold" />
        <TextBlock Text="{Binding ServerName}" Opacity="0.75" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>

    <!-- Primary action -->
    <Button DockPanel.Dock="Top"
            Margin="0,16"
            Height="52"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            FontSize="16"
            Content="{Binding ConnectButtonText}"
            Command="{Binding ToggleConnectionCommand}"
            IsEnabled="{Binding !IsBusy}" />

    <!-- Quick actions -->
    <WrapPanel DockPanel.Dock="Bottom" Margin="0,18,0,0" ItemWidth="150" ItemHeight="34">
      <Button Content="EN" Command="{Binding SetLanguageCommand}" CommandParameter="en" Margin="0,0,6,6" />
      <Button Content="RU" Command="{Binding SetLanguageCommand}" CommandParameter="ru" Margin="0,0,6,6" />
      <Button Content="中文" Command="{Binding SetLanguageCommand}" CommandParameter="zh-Hans" Margin="0,0,6,6" />
    </WrapPanel>

    <!-- Details -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="10">
        <TextBlock Text="{Binding LabelStatus}" FontWeight="SemiBold" Margin="0,8,0,0" />

        <ItemsControl ItemsSource="{Binding Details}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DetailRow">
              <Grid ColumnDefinitions="150,*" Margin="0,3">
                <TextBlock Grid.Column="0" Text="{Binding Label}" Opacity="0.6" FontSize="13" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
          <CheckBox Content="{Binding AdvancedModeLabel}" IsChecked="{Binding AdvancedMode}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

  </DockPanel>
</Window>
