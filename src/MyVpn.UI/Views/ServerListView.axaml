<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyVpn.UI.ViewModels"
             x:Class="MyVpn.UI.Views.ServerListView"
             x:DataType="vm:ServerListViewModel">

  <!--
    Selection, not action. Picking a row stages the choice; connecting is still the connect
    button, because switching a live server is a teardown and a connect and that decision
    belongs to a deliberate press rather than to a list selection.
  -->
  <DockPanel>
    <TextBlock DockPanel.Dock="Top"
               Text="{Binding Heading}"
               FontWeight="SemiBold"
               Margin="0,8,0,8" />

    <TextBlock DockPanel.Dock="Top"
               Text="{Binding EmptyText}"
               Opacity="0.6"
               FontSize="13"
               IsVisible="{Binding IsEmpty}" />

    <ListBox ItemsSource="{Binding Profiles}"
             SelectedItem="{Binding Selected}"
             IsVisible="{Binding !IsEmpty}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ServerEntry">
          <StackPanel Spacing="2" Margin="0,3">
            <TextBlock Text="{Binding DisplayName}" FontSize="14" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.6" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
