<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MyVpn.UI — the Avalonia desktop shell.

    The UI never touches the firewall, routes, DNS, the Xray process or any
    privileged API. It speaks only to IMyVpnServiceFacade, which is either the
    in-process facade (proxy-only, unprivileged mode) or the IPC-backed facade
    (TUN/Kill Switch mode). That single rule is what keeps privilege escalation
    out of the GUI.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>MyVpn.UI</RootNamespace>
    <AssemblyName>myvpn-ui</AssemblyName>
    <IsPackable>false</IsPackable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MyVpn.Core/MyVpn.Core.csproj" />
    <ProjectReference Include="../MyVpn.Application/MyVpn.Application.csproj" />
    <ProjectReference Include="../MyVpn.Infrastructure/MyVpn.Infrastructure.csproj" />
    <ProjectReference Include="../MyVpn.Platform.Abstractions/MyVpn.Platform.Abstractions.csproj" />
    <ProjectReference Include="../MyVpn.Ipc/MyVpn.Ipc.csproj" />

    <!--
      The three platform implementation projects, referenced so that the composition root can
      construct the platform factory for the operating system it is running on. This is the
      single privileged-adjacent decision the UI makes: it chooses a factory, and from then on
      touches nothing but the port interfaces the factory hands it. Every concrete executor
      (firewall, routes, DNS, system proxy) is used only through MyVpn.Application's
      IVpnSession, which is what keeps privilege escalation out of the view models.

      All three are referenced rather than one per build configuration because the platform is
      selected at runtime (Directory.Build.props targets plain net8.0 everywhere), which is what
      lets the whole solution build and test on a single CI runner.
    -->
    <ProjectReference Include="../MyVpn.Platform.Linux/MyVpn.Platform.Linux.csproj" />
    <ProjectReference Include="../MyVpn.Platform.MacOS/MyVpn.Platform.MacOS.csproj" />
    <ProjectReference Include="../MyVpn.Platform.Windows/MyVpn.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization/locales/*.json" />
  </ItemGroup>

</Project>
