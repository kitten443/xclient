<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MyVpn.Application — use cases and the ports (interfaces) they depend on.
    Depends only on Core plus logging abstractions. Crucially it does NOT
    depend on Infrastructure or any platform assembly: the concrete
    implementations are injected, which is what makes the use cases testable
    with fakes.
  -->

  <PropertyGroup>
    <RootNamespace>MyVpn.Application</RootNamespace>
    <AssemblyName>MyVpn.Application</AssemblyName>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MyVpn.Core/MyVpn.Core.csproj" />

    <!--
      The platform *abstractions* are contracts, not implementations, so depending on them keeps
      the dependency rule intact: the application layer can express "arm the kill switch" without
      knowing whether that means nftables, WFP or PF.
    -->
    <ProjectReference Include="../MyVpn.Platform.Abstractions/MyVpn.Platform.Abstractions.csproj" />
  </ItemGroup>

</Project>
