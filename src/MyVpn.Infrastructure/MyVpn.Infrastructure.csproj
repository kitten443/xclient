<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MyVpn.Infrastructure — concrete adapters for everything that is not
    OS-privileged: the Xray process engine, geo data management, subscription
    download/parsing, logging, updates and the filesystem abstraction.

    It depends on Core + Application + the platform abstractions (so it can
    orchestrate them) but NOT on any concrete platform assembly.
  -->

  <PropertyGroup>
    <RootNamespace>MyVpn.Infrastructure</RootNamespace>
    <AssemblyName>MyVpn.Infrastructure</AssemblyName>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MyVpn.Core/MyVpn.Core.csproj" />
    <ProjectReference Include="../MyVpn.Application/MyVpn.Application.csproj" />
    <ProjectReference Include="../MyVpn.Platform.Abstractions/MyVpn.Platform.Abstractions.csproj" />
  </ItemGroup>

</Project>
