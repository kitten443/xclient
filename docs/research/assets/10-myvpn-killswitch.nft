#!/usr/sbin/nft -f
# MyVpn kill switch — fail-closed, dual-stack, single atomic transaction.
# OWNERSHIP: table names are MyVpn-namespaced so they never collide with the
# distro's own firewall (which uses `table inet filter`, `table ip filter`, ...).
# LOADED BY: the MyVpn privileged helper as root. Never loaded at package
# install time (the endpoint set must be populated first — see the report).
#
# Idempotent atomic replacement: delete+redefine happen in ONE transaction, so
# there is no instant where egress is unfiltered.
#   https://wiki.nftables.org/wiki-nftables/index.php/Atomic_rule_replacement

define VPN_IF   = "myvpn0"
define VPN_PORT = 443

table inet myvpn_ks
delete table inet myvpn_ks

table inet myvpn_ks {
	# Populated by the helper from resolved VPN endpoint IPs BEFORE the drop
	# policy goes live. interval => accepts CIDR ranges as well as hosts.
	set vpn_endpoint4 { type ipv4_addr; flags interval; }
	set vpn_endpoint6 { type ipv6_addr; flags interval; }

	# ---- egress -------------------------------------------------------
	chain out {
		type filter hook output priority filter; policy drop;

		oifname "lo" accept comment "loopback"
		oifname $VPN_IF accept comment "the tunnel itself"

		# The VPN server is reachable ONLY in cleartext, by IP. The first rule is
		# deliberately protocol/port-INDEPENDENT: when the helper atomically
		# replaces the endpoint set, an in-flight tunnel session to an address
		# present in BOTH the old and the new set must not be interrupted
		# mid-reload. The explicit port rules below document and constrain the
		# intended transport.
		ip  daddr @vpn_endpoint4 accept
		ip6 daddr @vpn_endpoint6 accept
		ip  daddr @vpn_endpoint4 udp dport $VPN_PORT accept
		ip  daddr @vpn_endpoint4 tcp dport $VPN_PORT accept
		ip6 daddr @vpn_endpoint6 udp dport $VPN_PORT accept
		ip6 daddr @vpn_endpoint6 tcp dport $VPN_PORT accept

		# DHCP lease renewal on the physical uplink (must happen in clear).
		udp sport 68 udp dport 67 accept
		udp sport 67 udp dport 68 accept

		# ICMP/ICMPv6 are needed for PMTU discovery and IPv6 NDP/RS/RA.
		meta l4proto { icmp, ipv6-icmp } accept

		# Replies to inbound flows we allowed.
		ct state established,related accept

		counter drop comment "myvpn_ks: egress denied"
	}

	# ---- ingress ------------------------------------------------------
	chain in {
		type filter hook input priority filter; policy drop;

		iifname "lo" accept
		iifname $VPN_IF accept
		ct state established,related accept
		udp sport 67 udp dport 68 accept
		meta l4proto { icmp, ipv6-icmp } accept
		counter drop comment "myvpn_ks: ingress denied"
	}

	# ---- forwarded (containers, other netns) --------------------------
	chain forward_chain {
		type filter hook forward priority filter; policy drop;
	}
}
